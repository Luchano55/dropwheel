<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DropWheel</AssemblyName>
    <RootNamespace>DropWheel</RootNamespace>
    <StartupObject>DropWheel.App.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- DPI задаётся манифестом (PerMonitorV2) — это WPF-приложение, совет WinForms-анализатора не к нам. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms нужен только для значка в трее — его пространства имён не подключаем глобально. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF-проекты не подключают System.IO неявно. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DropWheel.Core\DropWheel.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DropWheel.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
</Project>
