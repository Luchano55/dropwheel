<Project Sdk="Microsoft.NET.Sdk">
  <!-- Тесты, которым нужна Windows (WPF, COM, WinRT). Не входят в DropWheel.sln: на Linux их не запустить.
       В CI запускаются отдельным шагом на windows-latest. Скриншоты — в папку из DROPWHEEL_SCREENSHOTS. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DropWheel\DropWheel.csproj" />
  </ItemGroup>
</Project>
